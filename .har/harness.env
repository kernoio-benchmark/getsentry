# Shared harness configuration for getsentry/sentry
# Maintained with `har env maintain`. Pure KEY=value config (schema-validated);
# Sentry-specific logic lives in .har/scripts/sentry-slot.sh, which the
# commands below call via the MAIN checkout's .har/ (git common dir), so they
# work from the main checkout (template DB) and from any session worktree.

export HARNESS_PROJECT_NAME=sentry
export HARNESS_USE_WORKTREE=true

# Primary application — the Sentry monolith web app: Django (`sentry devserver
# --no-watchers`) + its rsbuild frontend dev server. Two PM2 processes per slot
# (web, ui) — see ecosystem.agent.template.cjs.
export HARNESS_PRIMARY_APP=sentry-web

export HARNESS_TEMPLATE_DB=template_sentry

# ── Per-slot app ports (PM2 / primary app) ────────────────────────────────────
# Defaults: BASE + (AGENT_ID × HARNESS_PORT_STEP). Launch scans the slot lane
# when busy and writes resolved FE_PORT / API_PORT / DEBUG_PORT to .env.agent.<id>.
#   FE  = rsbuild dev server (open this in a browser)   slot 1 → 7010
#   API = Django (health, /api/0/)                      slot 1 → 7510
# Chosen to stay clear of the developer's own `devservices serve` (8000/8001),
# Relay (7899), dev-ui (7999) and HAR Mission Control (3847).
export HARNESS_FE_BASE_PORT=7000
export HARNESS_API_BASE_PORT=7500
export HARNESS_PORT_STEP=10
# Sentry's HealthCheck middleware (src/sentry/middleware/health.py).
export HARNESS_HEALTH_CHECK_PATH=/_health/

# ── Shared infra host ports (one per machine) ─────────────────────────────────
# One lane per infra service: <lane>=<default>:<scan_start>-<scan_end>.
# `db` is scanned by HAR. `redis` and `clickhouse` are NOT built-in HAR lanes,
# so their host ports are FIXED (start == end) in docker-compose.agent.yml; the
# entries document and reserve them. clickhouse = HTTP interface on 127.0.0.1
# for debugging only — slots' Snuba reach it on the docker network.
export HARNESS_INFRA_PORT_LANES="db=15432:15432-15499 redis=16479:16479-16479 clickhouse=18123:18123-18123"

# Agent slot limits — canonical source: .har/stages.json (agentSlots).
# A slot = Django devserver (~1.5 GB) + rsbuild dev (~3–4 GB RSS) + its .venv /
# node_modules (~4 GB disk per worktree). 3 fits a 16-core / 64 GB machine.
export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=3

# Toolchain provisioning — launch writes resolved paths into .env.agent.<id>.
# python: HAR creates the slot venv at .venv (Sentry's convention), then
# HARNESS_INSTALL_CMD runs with it active: `uv sync --frozen --inexact`, links
# the devenv-pinned Node (devenv/config.ini, .node-version) into .venv/bin and
# runs `pnpm install --frozen-lockfile` — i.e. what `devenv sync` does.
export HARNESS_ECOSYSTEM="python"
export HARNESS_PYTHON_VENV_DIR=".venv"
export HARNESS_INSTALL_CMD='bash "$(git rev-parse --path-format=absolute --git-common-dir)/../.har/scripts/sentry-slot.sh" install'

# Shared infrastructure — docker compose services from docker-compose.agent.yml,
# started ONCE by `har env setup-infra` and shared by all slots. clickhouse is
# shared too, but every slot gets its own Snuba API container + ClickHouse
# databases (hooks/post-launch.sh → scripts/sentry-slot.sh snuba-up).
export HARNESS_INFRA_SERVICES="db redis clickhouse"

# Database setup.
# - MIGRATE: `sentry upgrade --noinput`. Runs once against template_sentry (from
#   the main checkout, using a harness-owned venv in .har/state/template-venv),
#   then per slot at launch so schema drift from the branch is applied.
# - SEED: none needed. With DEBUG=True (the harness sentry.conf.py), Sentry's
#   post_upgrade receivers create the dev superuser admin@sentry.io / admin,
#   org `sentry` and project `internal` in the template; slots clone it.
export HARNESS_DB_MIGRATE_CMD='bash "$(git rev-parse --path-format=absolute --git-common-dir)/../.har/scripts/sentry-slot.sh" migrate'
export HARNESS_DB_SEED_CMD=""

# Agent-usable smoke (full verify `readiness` stage): login as the dev admin,
# authenticated org/project API call, UI login page + JS bundle via FE_PORT.
export HARNESS_READINESS_CMD='bash "$(git rev-parse --path-format=absolute --git-common-dir)/../.har/scripts/sentry-slot.sh" smoke'
