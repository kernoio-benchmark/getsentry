# Agent environment — generated by `har env launch` from .har/env.template
# DO NOT EDIT — regenerated on every launch
AGENT_ID=${AGENT_ID}

# Ports (allocated at launch — may differ from BASE + AGENT_ID × STEP when busy)
#   FE_PORT  = rsbuild dev server (the URL you open in a browser; proxies to API_PORT)
#   API_PORT = Django (`sentry devserver --no-watchers`), serves /_health/ and /api/0/
PORT=${API_PORT}
FE_PORT=${FE_PORT}
API_PORT=${API_PORT}
DEBUG_PORT=${DEBUG_PORT}

# PostgreSQL — per-slot database agent_<id>, cloned from template_sentry
PGHOST=localhost
PGPORT=${DB_PORT}
PGDATABASE=agent_${AGENT_ID}
PGUSER=postgres
PGPASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:${DB_PORT}/agent_${AGENT_ID}

# Redis — shared container on a FIXED host port, per-slot logical DB index
REDIS_PORT=16479
REDIS_DB=${AGENT_ID}

# Sentry — per-slot config dir, (re)generated by .har/scripts/sentry-slot.sh
# from the variables above on every launch (git-excluded inside the worktree).
SENTRY_CONF=${REPO_ROOT}/.sentry-har
SENTRY_ENVIRONMENT=development
# No Spotlight sidecar in slots (it would retry localhost:8969 forever).
SENTRY_SPOTLIGHT=0
# Snuba — this slot's own Snuba API container (har-sentry-snuba-agent<id>),
# started by hooks/post-launch.sh, backed by ClickHouse database har_agent<id>.
# Port = "1218" followed by the agent id (slot 1 → 12181); pytest uses a second
# container on "1228<id>" (see scripts/sentry-slot.sh snuba-up).
SNUBA=http://127.0.0.1:1218${AGENT_ID}

# uv: always use the slot venv's interpreter. prek hooks (`uv run flake8`,
# `uv run mypy`) otherwise re-resolve .python-version and fail when the local
# uv can't provide that exact patch release.
UV_PYTHON=${REPO_ROOT}/.venv/bin/python
UV_PROJECT_ENVIRONMENT=${REPO_ROOT}/.venv

# Application
NODE_ENV=development
SITE_URL=http://localhost:${FE_PORT}

# Toolchain paths — appended by the packaged launch provisioning step
# (PYTHON_BIN, VIRTUAL_ENV, PATH with .venv/bin first — node 26 is linked there)
